# Files received from classmates, kept locally as the originals behind the
# redacted fixtures in tests/fixtures/. They still carry names and
# registration numbers, so they must never be committed. The redacted copies
# in tests/fixtures/ are the ones that travel; see tests/fixtures/README.md.
circ files/

__pycache__/
*.pyc
.pytest_cache/

# LTspice and ngspice run artefacts
*.raw
*.log
*.op.raw
*.net

# SECRETS. Never commit a key. This entry goes in BEFORE any .env exists,
# because a key committed once lives in the history forever even after it is
# deleted from the working tree. .env.example is the committed template and
# holds no real values.
.env
.env.*
!.env.example

# Build artefacts from `pip install -e .`
*.egg-info/

# CLAUDE.md is the WORKING FILE: session state, open questions, decisions in
# progress, what to do next. It is not documentation and it is not the story
# a reader of this repo wants. Its durable content -- the derived format
# facts, the incident table, the verification limits -- lives in
# ARCHITECTURE.md, which IS committed. Excluded from the FIRST commit rather
# than removed later, because history is forever.
# AGENTS.md is the same document under the name Codex looks for, ignored for
# the same reason. (Its entry was once mangled into comment prose with no
# leading '#': a pattern that matched nothing, so the file showed untracked.)
CLAUDE.md
AGENTS.md

# The rendered site is GENERATED from library/. Committing it would put a
# second copy of every published number in the repo, free to drift from the
# manifests it came from, and would bury real library diffs under regenerated
# HTML. Build it with:  python -m ohmwork --library library --build-site site
site/

# The frontend build. Generated from web/src; committing it would put a
# second copy of the app in the repo, free to drift from its source.
web/node_modules/
web/dist/

# Desktop release artefacts. These are platform-native executable bundles and
# installers, not source: CI creates them on Windows/macOS and attaches them
# to a release. Keeping them out avoids a Windows binary looking like a Mac
# build merely because it sits beside one.
desktop/node_modules/
desktop/dist/
# The vendored evaluator bundle (the pinned Logisim JAR + jlink runtime).
# ~130 MB of third-party binaries rebuilt reproducibly by
# desktop/fetch-logisim.ps1 from the sha256 pins in logisim-bundle.json,
# which IS committed. tests/test_desktop_bundle.py is its acceptance.
desktop/vendor/
desktop-backend/*
!desktop-backend/.gitkeep
.desktop-pyinstaller-build/
.desktop-pyinstaller-spec/

# Scratch output from local --solve runs: directories, logs, question-text
# files, driver scripts -- anything scratch. The old dir-and-log-only pair
# let bare .scratch_* files reach the staging area twice in one day.
.scratch_*
