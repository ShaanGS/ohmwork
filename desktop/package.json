{
  "name": "ohmwork-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local desktop shell for Ohmwork",
  "author": "ShaanGS",
  "license": "MIT",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "package:win": "node ensure-bundle.mjs && electron-builder --win nsis",
    "package:mac": "node ensure-bundle.mjs && electron-builder --mac dmg",
    "package:dir": "node ensure-bundle.mjs && electron-builder --dir"
  },
  "build": {
    "appId": "edu.srm.ohmwork",
    "productName": "Ohmwork",
    "files": ["main.mjs", "preload.cjs"],
    "extraResources": [
      {"from": "../web/dist", "to": "web/dist"},
      {"from": "../desktop-backend", "to": "backend", "filter": ["**/*"]},
      {"from": "vendor/logisim", "to": "logisim", "filter": ["**/*"]}
    ],
    "win": {"target": "nsis", "icon": "build/icon.ico"},
    "mac": {"target": "dmg", "category": "public.app-category.education",
            "icon": "build/icon.png"}
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  }
}
