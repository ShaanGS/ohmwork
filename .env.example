# ohmwork configuration. Copy this file to `.env` and fill in your key:
#
#     cp .env.example .env
#
# `.env` is gitignored. This template is committed and must never hold a
# real value.

# Your Groq API key. Free tier: https://console.groq.com  -> API Keys
GROQ_API_KEY=gsk_replace_me

# Which provider writes generated text. "groq" (default) or "anthropic".
# OHMWORK_LLM=groq

# Which model. Leave unset to use the built-in default, which WILL go stale:
# hosted catalogues change faster than this repo does. To see what your
# account can actually serve:
#
#     python -m ohmwork --list-models
#
# OHMWORK_LLM_MODEL=llama-3.3-70b-versatile

# Only needed if you set OHMWORK_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-replace_me

# Simulator paths, if they are not where the tool looks by default.
# OHMWORK_LTSPICE=F:\LTspice.exe
# OHMWORK_LOGISIM=C:\Program Files\logisim-evolution\logisim-evolution.exe
