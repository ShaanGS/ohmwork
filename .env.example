# ohmwork configuration. Copy this file to `.env` and fill in your key(s):
#
#     cp .env.example .env
#
# `.env` is gitignored. This template is committed and must never hold a
# real value.

# ---------------------------------------------------------------- keys
#
# Set as many as you can get. Every one of these has a free tier, and the
# pool below turns several free accounts into something that answers without
# a rate-limit pause between calls. Set only one and everything still works,
# just slower.
#
# Several accounts at the SAME vendor is evasion of that vendor's terms and
# is deliberately not what the pool does. One account each, at different
# vendors, is ordinary use.

GROQ_API_KEY=gsk_replace_me                 # https://console.groq.com
# CEREBRAS_API_KEY=csk-replace_me           # https://cloud.cerebras.ai
# GEMINI_API_KEY=replace_me                 # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=sk-or-replace_me       # https://openrouter.ai/keys
# MISTRAL_API_KEY=replace_me                # https://console.mistral.ai

# Only if you have one; Anthropic is not a free tier, so it never joins the
# pool unless you name it in OHMWORK_LLM_POOL yourself.
# ANTHROPIC_API_KEY=sk-ant-replace_me

# ------------------------------------------------------------ which one
#
# "groq" (default), "cerebras", "gemini", "openrouter", "mistral",
# "anthropic", or "pool".
#
# "pool" uses every provider whose key is set, in order, and moves to the
# next one the moment a free tier says "slow down". It waits only when every
# member is rate limited at once. Which member answered is recorded with the
# result -- "pool" is never written down as if it were a model.
#
# OHMWORK_LLM=pool

# Membership, if you do not want all of them. Order is the order tried.
# OHMWORK_LLM_POOL=groq,cerebras,gemini

# ------------------------------------------------------------ which model
#
# Model ids go stale: hosted catalogues change faster than this repo does.
# To see what your accounts can actually serve right now:
#
#     python -m ohmwork --list-models
#
# For a single provider:
# OHMWORK_LLM_MODEL=openai/gpt-oss-120b
#
# For one member of a pool. The global setting above is deliberately NOT
# applied to every member -- a Groq id would 404 on Gemini, and the failure
# would look like four dead vendors rather than one misapplied setting.
# OHMWORK_LLM_MODEL_CEREBRAS=llama-3.3-70b
# OHMWORK_LLM_MODEL_GEMINI=gemini-2.5-flash

# Simulator paths, if they are not where the tool looks by default.
# OHMWORK_LTSPICE=F:\LTspice.exe
# OHMWORK_LOGISIM=C:\Program Files\logisim-evolution\logisim-evolution.exe
